{
  "name": "rise",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:https": "next dev --experimental-https",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit --incremental false",
    "check": "node scripts/check-pose.ts && node scripts/check-data.ts && node scripts/check-cameras.ts",
